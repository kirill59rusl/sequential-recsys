# Скопируйте этот файл в .env и впишите свои значения:
#   cp .env.example .env
#
# Как получить: kaggle.com -> Account -> Settings -> API -> "Create New Token"
# Скачается kaggle.json с полями "username" и "key" - перенесите их сюда.

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
